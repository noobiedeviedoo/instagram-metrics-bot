# Copia este archivo como .env si quieres probar el script en local.
# NUNCA subas el .env real a git.
#
# En GitHub Actions estas dos van como Secrets del repo, no aqui.

IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

